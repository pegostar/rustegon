{
  "description": "TC-API-003 REST transactions: begin, status, heartbeat, commit, rollback; documents and queries inside.",
  "steps": [
    {
      "body": {
        "delivery": "token",
        "password": "q7Vz!m2Lp#9Rx4Tk",
        "user": "admin"
      },
      "capture": {
        "token": "/body/sessionToken"
      },
      "expect": {
        "body": {
          "expiresAtUnixMs": "<unix-ms>",
          "mustChangePassword": false,
          "sessionToken": "${token}",
          "user": "admin"
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 200
      },
      "method": "POST",
      "name": "login",
      "path": "/api/v1/auth/login"
    },
    {
      "body": {
        "name": "shop"
      },
      "expect": {
        "body": {
          "created": true
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 200
      },
      "headers": {
        "authorization": "Bearer ${token}"
      },
      "method": "POST",
      "name": "create database",
      "path": "/api/v1/databases"
    },
    {
      "body": {
        "name": "items"
      },
      "expect": {
        "body": {
          "created": true
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 200
      },
      "headers": {
        "authorization": "Bearer ${token}"
      },
      "method": "POST",
      "name": "create collection",
      "path": "/api/v1/databases/shop/collections"
    },
    {
      "body": {
        "isolation": "snapshot"
      },
      "capture": {
        "txn": "/body/txnId"
      },
      "expect": {
        "body": {
          "heartbeatIntervalMs": 1000,
          "txnId": "${txn}"
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 200
      },
      "headers": {
        "authorization": "Bearer ${token}"
      },
      "method": "POST",
      "name": "begin",
      "path": "/api/v1/transactions"
    },
    {
      "body": {
        "documents": [
          {
            "_id": 1,
            "n": 1
          }
        ]
      },
      "expect": {
        "body": {
          "results": [
            {
              "id": 1,
              "rev": "<rev>"
            }
          ],
          "warnings": []
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 200
      },
      "headers": {
        "authorization": "Bearer ${token}",
        "rgn-txn-id": "${txn}"
      },
      "method": "POST",
      "name": "insert inside the transaction (rgn-txn-id header)",
      "path": "/api/v1/databases/shop/collections/items/documents"
    },
    {
      "body": {
        "rgql": "FROM items",
        "txnId": "${txn}"
      },
      "expect": {
        "body": {
          "rows": [
            {
              "_createdAt": "<datetime>",
              "_id": 1,
              "_rev": "<rev>",
              "_updatedAt": "<datetime>",
              "n": 1
            }
          ],
          "stats": {
            "docsAffected": 0,
            "docsReturned": 1,
            "executionTimeUs": "<us>"
          },
          "warnings": []
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 200
      },
      "headers": {
        "authorization": "Bearer ${token}"
      },
      "method": "POST",
      "name": "query inside the transaction (txnId member)",
      "path": "/api/v1/databases/shop/query"
    },
    {
      "expect": {
        "body": {
          "state": "active"
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 200
      },
      "headers": {
        "authorization": "Bearer ${token}"
      },
      "method": "GET",
      "name": "status",
      "path": "/api/v1/transactions/${txn}"
    },
    {
      "expect": {
        "body": {
          "expiresInMs": "<ms>"
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 200
      },
      "headers": {
        "authorization": "Bearer ${token}"
      },
      "method": "POST",
      "name": "heartbeat",
      "path": "/api/v1/transactions/${txn}/heartbeat"
    },
    {
      "expect": {
        "body": {},
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 200
      },
      "headers": {
        "authorization": "Bearer ${token}"
      },
      "method": "POST",
      "name": "commit",
      "path": "/api/v1/transactions/${txn}/commit"
    },
    {
      "expect": {
        "body": {
          "document": {
            "_createdAt": "<datetime>",
            "_id": 1,
            "_rev": "<rev>",
            "_updatedAt": "<datetime>",
            "n": 1
          }
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "etag": "<etag>",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 200
      },
      "headers": {
        "authorization": "Bearer ${token}"
      },
      "method": "GET",
      "name": "visible after commit",
      "path": "/api/v1/databases/shop/collections/items/documents/1"
    },
    {
      "body": {},
      "capture": {
        "rb": "/body/txnId"
      },
      "expect": {
        "body": {
          "heartbeatIntervalMs": 1000,
          "txnId": "${rb}"
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 200
      },
      "headers": {
        "authorization": "Bearer ${token}"
      },
      "method": "POST",
      "name": "begin a transaction to roll back",
      "path": "/api/v1/transactions"
    },
    {
      "body": {
        "documents": [
          {
            "_id": 2
          }
        ]
      },
      "expect": {
        "body": {
          "results": [
            {
              "id": 2,
              "rev": "<rev>"
            }
          ],
          "warnings": []
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 200
      },
      "headers": {
        "authorization": "Bearer ${token}",
        "rgn-txn-id": "${rb}"
      },
      "method": "POST",
      "name": "insert, then roll back",
      "path": "/api/v1/databases/shop/collections/items/documents"
    },
    {
      "expect": {
        "body": {},
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 200
      },
      "headers": {
        "authorization": "Bearer ${token}"
      },
      "method": "POST",
      "name": "rollback",
      "path": "/api/v1/transactions/${rb}/rollback"
    },
    {
      "expect": {
        "body": {
          "error": {
            "code": 1030,
            "details": {},
            "message": "document not found",
            "name": "NotFound",
            "retryable": false,
            "traceId": "<trace-id>"
          }
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 404
      },
      "headers": {
        "authorization": "Bearer ${token}"
      },
      "method": "GET",
      "name": "rolled back write is not visible",
      "path": "/api/v1/databases/shop/collections/items/documents/2"
    },
    {
      "body": {
        "isolation": "chaos"
      },
      "expect": {
        "body": {
          "error": {
            "code": 1001,
            "details": {
              "body": "data"
            },
            "message": "request body does not match the expected schema",
            "name": "InvalidArgument",
            "retryable": false,
            "traceId": "<trace-id>"
          }
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 400
      },
      "headers": {
        "authorization": "Bearer ${token}"
      },
      "method": "POST",
      "name": "unknown isolation level",
      "path": "/api/v1/transactions"
    },
    {
      "expect": {
        "body": {
          "error": {
            "code": 1001,
            "details": {
              "field": "txn_id"
            },
            "message": "invalid transaction id",
            "name": "InvalidArgument",
            "retryable": false,
            "traceId": "<trace-id>"
          }
        },
        "headers": {
          "cache-control": "no-store",
          "content-type": "application/json",
          "rgn-node-id": "7",
          "rgn-server-time": "<unix-ms>",
          "x-content-type-options": "nosniff"
        },
        "status": 400
      },
      "headers": {
        "authorization": "Bearer ${token}"
      },
      "method": "GET",
      "name": "malformed transaction id",
      "path": "/api/v1/transactions/unknown-txn"
    }
  ]
}
