<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Rustegon.Driver</AssemblyName>
    <RootNamespace>Rustegon.Driver</RootNamespace>
    <PackageId>Rustegon.Driver</PackageId>
    <Description>Official .NET driver for the Rustegon distributed ACID document database.</Description>
    <PackageTags>rustegon;database;nosql;driver;grpc</PackageTags>
    <IsPackable>true</IsPackable>
    <!-- dotnet-driver.md §2: trimming/AOT compatible (enables the trim and AOT analyzers). -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- AC-DRV-001, TC-DRV-NET-027: the SDK's package validation runs on every pack. No baseline
         yet (first release); from the first published version on, PackageValidationBaselineVersion
         makes it check API compatibility against that release (PD-118). -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.StatusProto" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <!-- Client stubs of the public API (protocol.md §2), internal: the driver's own types are the API. -->
  <ItemGroup>
    <Protobuf Include="$(RustegonRepoRoot)proto\rustegon\v1\*.proto"
              ProtoRoot="$(RustegonRepoRoot)proto"
              GrpcServices="Client"
              Access="Internal" />
  </ItemGroup>

  <!-- PD-075: the error catalog and code → exception table are generated by
       crates/rustegon-common/tests/driver_tables.rs and compiled as is (never copied or edited here). -->
  <ItemGroup>
    <Compile Include="$(RustegonRepoRoot)drivers\conformance\generated\ErrorCodes.g.cs" Link="Errors\ErrorCodes.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rustegon.Driver.Tests" Key="$(RustegonPublicKey)" />
  </ItemGroup>

  <!-- dotnet-driver.md §7: the [RustegonDocument] source generator ships inside this package as an
       analyzer (built first, never a runtime reference of the driver). -->
  <ItemGroup>
    <ProjectReference Include="..\Rustegon.Driver.Generators\Rustegon.Driver.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Rustegon.Driver.Generators\bin\$(Configuration)\netstandard2.0\Rustegon.Driver.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
