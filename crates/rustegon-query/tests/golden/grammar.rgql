  GROUP BY device, time_bucket('1h', ts) AS hour AGG avg_temp = avg(temp), max_temp = max(temp);
--- canonical
CREATE CONTINUOUS AGGREGATE iot.telemetry_1h ON iot.telemetry GROUP BY device, time_bucket('1h', ts) AS hour AGG avg_temp = avg(temp), max_temp = max(temp);
--- json
{
  "kind": "create_continuous_aggregate",
  "name": {
    "database": "iot",
    "name": "telemetry_1h"
  },
  "on": {
    "database": "iot",
    "name": "telemetry"
  },
  "group": {
    "keys": [
      {
        "expr": {
          "kind": "path",
          "path": [
            "device"
          ]
        }
      },
      {
        "expr": {
          "kind": "call",
          "name": "time_bucket",
          "args": [
            {
              "kind": "literal",
              "value": "1h"
            },
            {
              "kind": "path",
              "path": [
                "ts"
              ]
            }
          ]
        },
        "alias": "hour"
      }
    ],
    "aggs": [
      {
        "name": "avg_temp",
        "expr": {
          "kind": "call",
          "name": "avg",
          "args": [
            {
              "kind": "path",
              "path": [
                "temp"
              ]
            }
          ]
        }
      },
      {
        "name": "max_temp",
        "expr": {
          "kind": "call",
          "name": "max",
          "args": [
            {
              "kind": "path",
              "path": [
                "temp"
              ]
            }
          ]
        }
      }
    ]
  }
}
