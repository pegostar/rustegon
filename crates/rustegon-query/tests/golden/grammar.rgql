=== spec_7_pipeline: pipe_stage stage_unwind stage_group stage_sort stage_limit agg_item mul_op
FROM shop.orders WHERE status = 'paid'
|> UNWIND items AS it
|> GROUP BY it.sku AGG qty = sum(it.qty), revenue = sum(it.qty * it.price)
|> SORT revenue DESC |> LIMIT 10;
--- canonical
FROM shop.orders WHERE status = 'paid' |> UNWIND items AS it |> GROUP BY it.sku AGG qty = sum(it.qty), revenue = sum(it.qty * it.price) |> SORT revenue DESC |> LIMIT 10;
--- json
{
  "kind": "query",
  "from": {
    "source": {
      "kind": "collection",
      "database": "shop",
      "name": "orders"
    }
  },
  "where": {
    "kind": "binary",
    "op": "eq",
    "left": {
      "kind": "path",
      "path": [
        "status"
      ]
    },
    "right": {
      "kind": "literal",
      "value": "paid"
    }
  },
  "pipeline": [
    {
      "kind": "unwind",
      "path": [
        "items"
      ],
      "alias": "it"
    },
    {
      "kind": "group",
      "keys": [
        {
          "expr": {
            "kind": "path",
            "path": [
              "it",
              "sku"
            ]
          }
        }
      ],
      "aggs": [
        {
          "name": "qty",
          "expr": {
            "kind": "call",
            "name": "sum",
            "args": [
              {
                "kind": "path",
                "path": [
                  "it",
                  "qty"
                ]
              }
            ]
          }
        },
        {
          "name": "revenue",
          "expr": {
            "kind": "call",
            "name": "sum",
            "args": [
              {
                "kind": "binary",
                "op": "mul",
                "left": {
                  "kind": "path",
                  "path": [
                    "it",
                    "qty"
                  ]
                },
                "right": {
                  "kind": "path",
                  "path": [
                    "it",
                    "price"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "kind": "sort",
      "items": [
        {
          "expr": {
            "kind": "path",
            "path": [
              "revenue"
            ]
          },
          "descending": true
        }
      ]
    },
    {
      "kind": "limit",
      "count": {
        "kind": "literal",
        "value": 10
      }
    }
  ]
}
