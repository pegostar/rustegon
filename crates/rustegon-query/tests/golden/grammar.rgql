=== spec_5_read_example: query from_clause from_alias qualified_name where_clause select_clause projection_alias order_clause limit_clause in_op and_op ge_op gt_op param_named call interval_literal sub_op path_dot statement_separator
FROM shop.orders AS o
WHERE o.status IN ['paid', 'shipped'] AND o.total >= $min AND o.createdAt > now() - interval '7 days'
SELECT o._id, o.total, o.customer.name AS customer
ORDER BY o.createdAt DESC
LIMIT 50;
--- canonical
FROM shop.orders AS o WHERE o.status IN ['paid', 'shipped'] AND o.total >= $min AND o.createdAt > now() - INTERVAL '7 days' SELECT o._id, o.total, o.customer.name AS customer ORDER BY o.createdAt DESC LIMIT 50;
--- json
{
  "kind": "query",
  "from": {
    "source": {
      "kind": "collection",
      "database": "shop",
      "name": "orders"
    },
    "alias": "o"
  },
  "where": {
    "kind": "and",
    "args": [
      {
        "kind": "binary",
        "op": "in",
        "left": {
          "kind": "path",
          "path": [
            "o",
            "status"
          ]
        },
        "right": {
          "kind": "array",
          "elements": [
            {
              "kind": "literal",
              "value": "paid"
            },
            {
              "kind": "literal",
              "value": "shipped"
            }
          ]
        }
      },
      {
        "kind": "binary",
        "op": "ge",
        "left": {
          "kind": "path",
          "path": [
            "o",
            "total"
          ]
        },
        "right": {
          "kind": "param",
          "name": "min"
        }
      },
      {
        "kind": "binary",
        "op": "gt",
        "left": {
          "kind": "path",
          "path": [
            "o",
            "createdAt"
          ]
        },
        "right": {
          "kind": "binary",
          "op": "sub",
          "left": {
            "kind": "call",
            "name": "now",
            "args": []
          },
          "right": {
            "kind": "literal",
            "type": "interval",
            "value": "7 days"
          }
        }
      }
    ]
  },
  "select": {
    "kind": "items",
    "items": [
      {
        "kind": "expr",
        "expr": {
          "kind": "path",
          "path": [
            "o",
            "_id"
          ]
        }
      },
      {
        "kind": "expr",
        "expr": {
          "kind": "path",
          "path": [
            "o",
            "total"
          ]
        }
      },
      {
        "kind": "expr",
        "expr": {
          "kind": "path",
          "path": [
            "o",
            "customer",
            "name"
          ]
        },
        "alias": "customer"
      }
    ]
  },
  "order_by": [
    {
      "expr": {
        "kind": "path",
        "path": [
          "o",
          "createdAt"
        ]
      },
      "descending": true
    }
  ],
  "limit": {
    "kind": "literal",
    "value": 50
  }
}
