=== spec_11_create_collection: create_collection
CREATE COLLECTION shop.orders WITH (shard_key = hashed(_id), compression = 'zstd(3)',
       validator = $schema, revisions = {enabled: true, max: 50}, change_stream_pre_post_images = true,
       ttl = '30 days');
--- canonical
CREATE COLLECTION shop.orders WITH (shard_key = hashed(_id), compression = 'zstd(3)', validator = $schema, revisions = {enabled: TRUE, max: 50}, change_stream_pre_post_images = TRUE, ttl = '30 days');
--- json
{
  "kind": "create_collection",
  "name": {
    "database": "shop",
    "name": "orders"
  },
  "options": [
    {
      "name": "shard_key",
      "value": {
        "kind": "call",
        "name": "hashed",
        "args": [
          {
            "kind": "path",
            "path": [
              "_id"
            ]
          }
        ]
      }
    },
    {
      "name": "compression",
      "value": {
        "kind": "literal",
        "value": "zstd(3)"
      }
    },
    {
      "name": "validator",
      "value": {
        "kind": "param",
        "name": "schema"
      }
    },
    {
      "name": "revisions",
      "value": {
        "kind": "object",
        "fields": [
          {
            "name": "enabled",
            "value": {
              "kind": "literal",
              "value": true
            }
          },
          {
            "name": "max",
            "value": {
              "kind": "literal",
              "value": 50
            }
          }
        ]
      }
    },
    {
      "name": "change_stream_pre_post_images",
      "value": {
        "kind": "literal",
        "value": true
      }
    },
    {
      "name": "ttl",
      "value": {
        "kind": "literal",
        "value": "30 days"
      }
    }
  ]
}
=== data_model_6_create_table: create_table comment_line
CREATE TABLE metrics.sensor_readings (
  PARTITION KEY (sensor_id string, day datetime),
  CLUSTERING KEY (ts datetime DESC),
  STATIC (location object),
  DISTRIBUTION hashed,            -- default; or range
  DEFAULT TTL 2592000
);
--- canonical
CREATE TABLE metrics.sensor_readings (PARTITION KEY (sensor_id string, day datetime), CLUSTERING KEY (ts datetime DESC), STATIC (location object), DISTRIBUTION hashed, DEFAULT TTL 2592000);
--- json
{
  "kind": "create_table",
  "name": {
    "database": "metrics",
    "name": "sensor_readings"
  },
  "partition_key": [
    {
      "name": "sensor_id",
      "type": "string"
    },
    {
      "name": "day",
      "type": "datetime"
    }
  ],
  "clustering_key": [
    {
      "name": "ts",
      "type": "datetime",
      "descending": true
    }
  ],
  "static_columns": [
    {
      "name": "location",
      "type": "object"
    }
  ],
  "distribution": "hashed",
  "default_ttl": {
    "kind": "literal",
    "value": 2592000
  }
}
