    "kind": "and",
    "args": [
      {
        "kind": "binary",
        "op": "eq",
        "left": {
          "kind": "path",
          "path": [
            "sensor_id"
          ]
        },
        "right": {
          "kind": "literal",
          "value": "s1"
        }
      },
      {
        "kind": "binary",
        "op": "eq",
        "left": {
          "kind": "path",
          "path": [
            "day"
          ]
        },
        "right": {
          "kind": "literal",
          "type": "datetime",
          "value": "2026-11-02T00:00:00.000Z"
        }
      },
      {
        "kind": "binary",
        "op": "gt",
        "left": {
          "kind": "path",
          "path": [
            "ts"
          ]
        },
        "right": {
          "kind": "param",
          "name": "from"
        }
      }
    ]
  },
  "select": {
    "kind": "items",
    "items": [
      {
        "kind": "expr",
        "expr": {
          "kind": "path",
          "path": [
            "ts"
          ]
        }
      },
      {
        "kind": "expr",
        "expr": {
          "kind": "path",
          "path": [
            "temp"
          ]
        }
      },
      {
        "kind": "expr",
        "expr": {
          "kind": "call",
          "name": "writetime",
          "args": [
            {
              "kind": "path",
              "path": [
                "temp"
              ]
            }
          ]
        }
      }
    ]
  },
  "order_by": [
    {
      "expr": {
        "kind": "path",
        "path": [
          "ts"
        ]
      },
      "descending": true
    }
  ],
  "limit": {
    "kind": "literal",
    "value": 100
  },
  "options": [
    {
      "name": "consistency",
