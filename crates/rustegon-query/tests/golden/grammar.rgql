FROM metrics.sensor_readings WHERE sensor_id = 's1' AND day = DATE '2026-11-02T00:00:00.000Z' AND ts > $from SELECT ts, temp, writetime(temp) ORDER BY ts DESC LIMIT 100 OPTIONS (consistency = 'LOCAL_QUORUM');
