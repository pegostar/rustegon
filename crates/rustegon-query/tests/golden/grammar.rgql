=== spec_8_lookup: lookup_clause lookup_alias access_path
FROM shop.orders AS o
LOOKUP shop.customers AS c ON o.customerId = c._id INTO customer
SELECT o._id, first(customer).name AS name;
--- canonical
FROM shop.orders AS o LOOKUP shop.customers AS c ON o.customerId = c._id INTO customer SELECT o._id, first(customer).name AS name;
--- json
{
  "kind": "query",
  "from": {
    "source": {
      "kind": "collection",
      "database": "shop",
      "name": "orders"
    },
    "alias": "o"
  },
  "lookups": [
    {
      "collection": {
        "database": "shop",
        "name": "customers"
      },
      "alias": "c",
      "local": {
        "kind": "path",
        "path": [
          "o",
          "customerId"
        ]
      },
      "foreign": [
        "c",
        "_id"
      ],
      "into": "customer"
    }
  ],
  "select": {
    "kind": "items",
    "items": [
      {
        "kind": "expr",
        "expr": {
          "kind": "path",
          "path": [
            "o",
            "_id"
          ]
        }
      },
      {
        "kind": "expr",
        "expr": {
          "kind": "access",
          "base": {
            "kind": "call",
            "name": "first",
            "args": [
              {
                "kind": "path",
                "path": [
                  "customer"
                ]
              }
            ]
          },
          "path": [
            "name"
          ]
        },
        "alias": "name"
      }
    ]
  }
}
