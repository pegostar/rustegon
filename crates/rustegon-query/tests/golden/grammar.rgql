=== spec_11_mapreduce_index: create_mapreduce_index
CREATE MAPREDUCE INDEX sales_by_day ON shop.orders
  MAP (FROM shop.orders WHERE status='paid' SELECT date_trunc('day', paidAt) AS day, total)
  REDUCE (GROUP BY day AGG revenue = sum(total), orders = count(*));
--- canonical
CREATE MAPREDUCE INDEX sales_by_day ON shop.orders MAP (FROM shop.orders WHERE status = 'paid' SELECT date_trunc('day', paidAt) AS day, total) REDUCE (GROUP BY day AGG revenue = sum(total), orders = count(*));
--- json
{
  "kind": "create_mapreduce_index",
  "name": "sales_by_day",
  "on": {
    "database": "shop",
    "name": "orders"
  },
  "map": {
    "from": {
      "source": {
        "kind": "collection",
        "database": "shop",
        "name": "orders"
      }
    },
    "where": {
      "kind": "binary",
      "op": "eq",
      "left": {
        "kind": "path",
        "path": [
          "status"
        ]
      },
      "right": {
        "kind": "literal",
        "value": "paid"
      }
    },
    "select": {
      "kind": "items",
      "items": [
        {
          "kind": "expr",
          "expr": {
            "kind": "call",
            "name": "date_trunc",
            "args": [
              {
                "kind": "literal",
                "value": "day"
              },
              {
                "kind": "path",
                "path": [
                  "paidAt"
                ]
              }
            ]
          },
          "alias": "day"
        },
        {
          "kind": "expr",
          "expr": {
            "kind": "path",
            "path": [
              "total"
            ]
          }
        }
      ]
    }
  },
  "reduce": {
    "keys": [
      {
        "expr": {
          "kind": "path",
          "path": [
            "day"
          ]
        }
      }
    ],
    "aggs": [
      {
        "name": "revenue",
        "expr": {
          "kind": "call",
          "name": "sum",
          "args": [
            {
              "kind": "path",
              "path": [
                "total"
              ]
            }
          ]
        }
      },
      {
        "name": "orders",
        "expr": {
          "kind": "call",
          "name": "count",
          "args": [
            {
              "kind": "star"
            }
          ]
        }
      }
    ]
  }
}
=== spec_11_continuous_aggregate: create_continuous_aggregate group_key_alias
