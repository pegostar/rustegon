=== update_source
UPDATE orders SET qty = 1 WHERE status = 'new' LIMIT 3
--- logical
Limit limit=3
  Sort _id ASC
    Filter (status = 'new')
      Scan shop.orders
--- physical
Limit limit=3
  IndexOrder _id ASC
    IndexScan shop.orders.by_status [('new') .. ('new')] fetch
