=== compound_eq_range_desc
FROM orders WHERE status = 'paid' AND createdAt > DATE '2026-01-01'
--- logical
Filter ((status = 'paid') AND (createdAt > {"$date":"2026-01-01T00:00:00.000Z"}))
  Scan shop.orders
--- physical
IndexScan shop.orders.status_created [('paid') .. ('paid', {"$date":"2026-01-01T00:00:00.000Z"})) fetch
=== compound_eq_both_bounds_desc
FROM orders WHERE status = 'paid' AND createdAt >= 10 AND createdAt < 20
--- logical
Filter ((status = 'paid') AND (createdAt >= 10) AND (createdAt < 20))
  Scan shop.orders
--- physical
IndexScan shop.orders.status_created (('paid', 20) .. ('paid', 10)] fetch
=== compound_eq_upper_only_desc
FROM orders WHERE status = 'paid' AND createdAt < 20
--- logical
Filter ((status = 'paid') AND (createdAt < 20))
  Scan shop.orders
--- physical
Filter (createdAt < 20)
  IndexScan shop.orders.status_created (('paid', 20) .. ('paid')] fetch
=== between_rewritten
FROM orders WHERE qty BETWEEN 1 AND 5
--- logical
Filter ((qty >= 1) AND (qty <= 5))
  Scan shop.orders
