=== sort_eliminated
FROM orders WHERE status = 'paid' ORDER BY createdAt DESC LIMIT 10
--- logical
Limit limit=10
  Sort createdAt DESC
    Filter (status = 'paid')
      Scan shop.orders
--- physical
Limit limit=10
  IndexOrder createdAt DESC
    IndexScan shop.orders.status_created [('paid') .. ('paid')] fetch
=== sort_wrong_direction_topk
FROM orders WHERE status = 'paid' ORDER BY createdAt LIMIT 10
--- logical
Limit limit=10
  Sort createdAt ASC
    Filter (status = 'paid')
      Scan shop.orders
--- physical
Limit limit=10
  TopK k=10 createdAt ASC
    IndexScan shop.orders.by_status [('paid') .. ('paid')] fetch
=== sort_only_index
FROM orders ORDER BY status
--- logical
Sort status ASC
  Scan shop.orders
--- physical
IndexOrder status ASC
  IndexScan shop.orders.by_status (-inf .. +inf) fetch
=== sort_blocking_without_limit
FROM orders WHERE qty > 1 ORDER BY qty DESC, price
--- logical
Sort qty DESC, price ASC
  Filter (qty > 1)
    Scan shop.orders
--- physical
Sort qty DESC, price ASC
  Filter (qty > 1)
    CollectionScan shop.orders
=== topk_with_offset
FROM orders ORDER BY qty LIMIT 5 OFFSET 10
--- logical
Limit limit=5 offset=10
  Sort qty ASC
    Scan shop.orders
--- physical
Limit limit=5 offset=10
  TopK k=15 qty ASC
    CollectionScan shop.orders
