=== covered_projection
FROM orders WHERE sku = 'a1' SELECT sku, qty
--- logical
Project sku AS sku, qty AS qty
  Filter (sku = 'a1')
    Scan shop.orders
--- physical
Project sku AS sku, qty AS qty
  IndexScan shop.orders.cov [('a1') .. ('a1')] covered
