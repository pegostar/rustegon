DELETE FROM orders WHERE _id IN [1, 2]
--- logical
Sort _id ASC
  Filter (_id IN [1,2])
    Scan shop.orders
--- physical
Sort _id ASC
  PrimaryGet shop.orders ids=[1, 2]
